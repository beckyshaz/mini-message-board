<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Message Board</title>
</head>
<body>
    <h1><%=  title %></h1>
    <div>
        <% messages.forEach((message) => { %>

            <h2><%= message.username %></h2>
            <p><%= message.message %> </p>
            <a href="/<%= message.id %>">Open</a>
            <span><%= message.created_at %></span>


       <% }) %>
    </div>
    
</body>
</html>